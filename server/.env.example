# ---------- Server ----------
PORT=5000
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# ---------- AI agent (leave both empty to use the built-in scripted agent) ----------
GEMINI_API_KEY=
# Names change over time. The alias below always points at the current flash model.
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Product catalog (empty = built-in mock catalog) ----------
CHANNEL3_API_KEY=

# ---------- PayPal sandbox (empty = mock checkout) ----------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---------- Spending limits (USD, per account) ----------
BUDGET_TOTAL=5000
BUDGET_PER_PURCHASE=1500

# ---------- Accounts ----------
# Leave blank: a random secret is created in server/data/ and reused.
AUTH_SECRET=
# true = the OTP is shown on screen (no email needed). Use false only together with RESEND_API_KEY.
OTP_DEMO_MODE=true
RESEND_API_KEY=
MAIL_FROM=ProcureAI <onboarding@resend.dev>

# ---------- Demo account for judges ----------
# Defaults to on while OTP_DEMO_MODE=true. Everyone who uses it shares one set of data.
DEMO_ACCOUNT=true
DEMO_EMAIL=demo@procureai.app
DEMO_PASSWORD=Demo#ProcureAI1

# ---------- Protect your API quota ----------
# After this many AI-agent runs per day (all users together) the built-in scripted agent takes over.
AI_RUNS_PER_DAY=100
