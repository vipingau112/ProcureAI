# ---------- Server ----------
PORT=5000
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# ---------- AI agent (leave both empty to use the built-in scripted agent) ----------
GEMINI_API_KEY=
# Names change over time. The alias below always points at the current flash model.
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Product catalog (empty = built-in mock catalog) ----------
CHANNEL3_API_KEY=

# ---------- PayPal sandbox (empty = mock checkout) ----------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---------- Spending limits (USD, per account) ----------
BUDGET_TOTAL=5000
BUDGET_PER_PURCHASE=1500

# ---------- Database ----------
# PostgreSQL connection string, for example from a free Neon project. Empty = JSON files in server/data/.
DATABASE_URL=

# ---------- Accounts and OTP email ----------
# Leave blank: a random secret is created in server/data/ and reused. Set it on hosts with a temporary disk.
AUTH_SECRET=
# Gmail: turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
# (spaces in the password are fine). This sends the OTP from your Gmail address.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Alternative sender over HTTPS (used only when Gmail is not set)
RESEND_API_KEY=
MAIL_FROM=ProcureAI <onboarding@resend.dev>
# Defaults: with no email configured the OTP is shown on screen; with email configured it is only emailed.
# Set to true to do both, or false to force email only.
OTP_DEMO_MODE=
# Stops the signup form from being used to send unlimited email (Gmail allows roughly 500 a day).
MAX_EMAILS_PER_DAY=200

# ---------- Demo account for judges ----------
# Defaults to on only while the OTP is shown on screen. Set true to keep the button even when email is on.
DEMO_ACCOUNT=
DEMO_EMAIL=demo@procureai.app
DEMO_PASSWORD=Demo#ProcureAI1

# ---------- Protect your AI quota ----------
# After this many AI-agent runs per day (all users together) the built-in scripted agent takes over.
AI_RUNS_PER_DAY=100
